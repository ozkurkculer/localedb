{
    "name": "localedb",
    "version": "1.0.1",
    "private": true,
    "scripts": {
        "dev": "pnpm build:public-data && next dev -p 4200",
        "build": "pnpm build:public-data && next build",
        "build:clean": "pnpm update:data && pnpm build:data && pnpm build",
        "build:data": "tsx scripts/build-data.ts",
        "build:public-data": "tsx scripts/publish-data.ts",
        "update:data": "tsx scripts/update-data.ts",
        "full-build": "pnpm update:data && pnpm build:data",
        "start": "next start",
        "cf:build": "opennextjs-cloudflare build && tsx scripts/cloudflare-headers.ts",
        "preview": "pnpm cf:build && opennextjs-cloudflare preview",
        "deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
        "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
        "lint": "eslint",
        "parity": "tsx scripts/parity/parity.ts",
        "parity:export": "tsx scripts/parity/export.ts",
        "version": "tsx scripts/generate-changelog.ts",
        "packages:build": "pnpm --filter \"./packages/*\" build",
        "packages:test": "pnpm --filter \"./packages/*\" test",
        "packages:typecheck": "pnpm --filter \"./packages/*\" typecheck"
    },
    "dependencies": {
        "@localedb/core": "workspace:*",
        "@radix-ui/react-accordion": "^1.2.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "adm-zip": "^0.5.16",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "dotenv": "^17.3.1",
        "fast-xml-parser": "^5.3.6",
        "flag-icons": "^7.5.0",
        "framer-motion": "^12.34.0",
        "lucide-react": "^0.564.0",
        "next": "16.3.8",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.4.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.1",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "1.20.10",
        "@tailwindcss/postcss": "4.3.0",
        "@types/adm-zip": "^0.5.7",
        "@types/node": "^20.19.33",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.8",
        "shadcn": "^3.8.4",
        "tailwindcss": "4.3.0",
        "tsx": "^4.21.0",
        "typescript": "^5",
        "wrangler": "4.149.0"
    },
    "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8"
}
