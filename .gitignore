# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/docs/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

.docs
.claude
.docs*  
.claude*

# cloudflare (OpenNext build output, wrangler state, local secrets)
.open-next
.wrangler
.dev.vars*

# typescript
*.tsbuildinfo
next-env.d.ts

# Data directories (keep gitkeep or similar if needed, but ignore contents)
data/cldr/*
!data/cldr/.gitkeep
data/icu/*
!data/icu/.gitkeep
data/simplelocalize/*
!data/simplelocalize/.gitkeep
data/worldbankgroup/*.csv
data/airports.csv
data/mledoze.json
data/simplelocalize
data/worldbankgroup
data/icu
data/cldr
data/mledoze.json
data/*
data/countries
data/currencies
data/languages

data
# workspace package builds
packages/*/dist
packages/core/data

# the data access layer is source code, not generated data (the bare `data` rule above matches it)
!src/lib/data/
# request-time data published by scripts/publish-data.ts
public/_data
