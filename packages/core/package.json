{
  "name": "@localedb/core",
  "version": "0.1.0-beta.0",
  "description": "Structured localization data for every country: currencies, languages, date and number formats, phone numbers, addresses and airports.",
  "license": "MIT",
  "author": "Mehmet Emin Özkürkçüler (https://github.com/ozkurkculer)",
  "homepage": "https://localedb.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozkurkculer/localedb.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/ozkurkculer/localedb/issues",
  "keywords": [
    "localization",
    "l10n",
    "i18n",
    "cldr",
    "locale",
    "country",
    "currency",
    "iso-3166",
    "iso-4217",
    "bcp47"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
